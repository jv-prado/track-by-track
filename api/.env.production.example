# Atlas em produção — NÃO commitar valores reais. Configurar direto no host de deploy
# (Railway/Render/Fly/VPS — variáveis de ambiente do serviço, não um arquivo no repo).
NODE_ENV=production
PORT=3333
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/trackbytrack?retryWrites=true&w=majority
JWT_ACCESS_SECRET=<32+ chars, diferente do valor de dev>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
WEB_ORIGIN=https://<domínio de produção>
SPOTIFY_CLIENT_ID=<client id de produção>
SPOTIFY_CLIENT_SECRET=<secret de produção>
# Hoje só "console" é aceito (loga o link de reset em vez de enviar e-mail de verdade —
# ver EmailSenderPort/ConsoleEmailAdapter no CLAUDE.md seção 4.4). Nenhum provedor
# transacional real (Resend/SES/Postmark) está implementado ainda: setar qualquer outro
# valor aqui crasha o boot (validação Zod). Trocar exige escolher o provedor, implementar
# o adapter e só então mudar essa variável — não é só configuração.
EMAIL_SENDER_ADAPTER=console
CLOUDINARY_CLOUD_NAME=<cloud name de produção>
CLOUDINARY_API_KEY=<api key de produção>
CLOUDINARY_API_SECRET=<api secret de produção>

# cache: memory (default, 1 instancia) | redis | off
CACHE_DRIVER=memory
# REDIS_URL=redis://localhost:6380
CACHE_PREFIX=tbt
