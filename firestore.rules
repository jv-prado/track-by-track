rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modo de desenvolvimento - permite operações completas para usuários autenticados
    // ATENÇÃO: Altere estas regras antes de colocar em produção!
    match /usuarios/{userId} {
      // Permite leitura e escrita para usuários autenticados (ambiente de teste)
      allow read, write: if request.auth != null;
    }
    
    // Regras para outras coleções durante o desenvolvimento
    match /{document=**} {
      // Permite operações para usuários autenticados durante o desenvolvimento
      // REMOVA ESTA REGRA PARA PRODUÇÃO
      allow read, write: if request.auth != null;
    }
  }
} 