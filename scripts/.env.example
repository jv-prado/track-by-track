# Caminho pro JSON da service account (Firebase Console > Configurações do projeto >
# Contas de serviço > Gerar nova chave privada). NUNCA commitar o arquivo em si.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\caminho\para\trackbytrack-57ae6-firebase-adminsdk.json

# Se vazio, o script tenta ler api/.env automaticamente (MONGODB_URI de lá).
# Só preencha aqui se quiser apontar pra um Mongo diferente do usado em dev.
MONGODB_URI=

# Necessário pra resolver trackNumber de cada faixa via Spotify (Client Credentials).
# Se vazio, o script tenta ler api/.env automaticamente.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Trava de segurança: só necessário quando MONGODB_URI aponta pra Atlas (mongodb+srv)
# e --dry-run NÃO foi passado. Exige backup/export do Firestore feito antes.
# CONFIRM_PRODUCTION_MIGRATION=eu-fiz-backup-do-firestore
